DB_HOST = "127.0.0.1"
DB_PORT = 3306
DB_NAME = "app_db"
DB_USER = "app_admin"
DB_PASSWORD = "<.env의 MYSQL_USER_PASSWORD와 동일한 값>"

AI_WORKER_IP   = "<LM Studio가 떠 있는 호스트 IP>"
AI_WORKER_PORT = 1234
AI_MODEL_NAME  = "<LM Studio에 로드된 모델명, 예: qwen/qwen3-8b>"
# 사고 모드 (기본 false). 평가에서 정확도는 비슷하고 응답만 수십 초~수 분 길어졌다.
# 사고 모드를 지원하는 모델(qwen/qwen3-8b 등)에서만 효과가 있다.
AI_THINK       = false

# SELECT 실행 시간 상한 (ms, 기본 30000). 넘으면 MySQL이 조회를 중단한다.
# DB_SELECT_TIMEOUT_MS = 30000
