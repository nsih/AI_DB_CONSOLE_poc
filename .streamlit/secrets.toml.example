DB_HOST = "127.0.0.1"
DB_PORT = 3306
DB_NAME = "csu_db"
DB_USER = "csu_admin"
DB_PASSWORD = "<.env의 MYSQL_USER_PASSWORD와 동일한 값>"

AI_WORKER_IP   = "<LM Studio가 떠 있는 호스트 IP>"
AI_WORKER_PORT = 1234
AI_MODEL_NAME  = "<LM Studio에 로드된 모델명, 예: qwen/qwen3-8b>"
# 사고 모드 (기본 true). 정확도가 오르는 대신 응답이 수 분까지 길어진다.
# 사고 모드를 지원하는 모델(qwen/qwen3-8b 등)에서만 효과가 있다.
AI_THINK       = true
